SELECTION_FILE = f"{BASE}/selected_patches_v2.txt"
LOCAL_AUTH_DIR = "/content/lodo_cache/authentic"

def read_manifest():
    with open(SELECTION_FILE) as f:
        return [line.strip() for line in f if line.strip()]

def copy_one_with_retry(filename, retries=5, delay=3.0):
    src = os.path.join(AUTHENTIC_PATH, filename)
    dst = os.path.join(LOCAL_AUTH_DIR, filename)
    if os.path.exists(dst):
        return True
    for attempt in range(retries):
        try:
            shutil.copy2(src, dst)
            return True
        except OSError:
            if attempt == retries - 1:
                return False
            time.sleep(delay)
    return False

os.makedirs(LOCAL_AUTH_DIR, exist_ok=True)
filenames = read_manifest()
print(f"Manifest contains {len(filenames)} filenames")

already = len([f for f in os.listdir(LOCAL_AUTH_DIR) if f.endswith('.png')])
