t0 = time.time()
failed = []
for i, fname in enumerate(filenames):
    ok = copy_one_with_retry(fname)
    if not ok:
        failed.append(fname)
    if (i + 1) % 500 == 0:
        print(f"  {i+1}/{len(filenames)} processed ({time.time()-t0:.0f}s, {len(failed)} failed)")

succeeded = len(filenames) - len(failed)
print(f"Done: {succeeded}/{len(filenames)} cached in {time.time()-t0:.0f}s")
if failed:
    print(f"Failed: {len(failed)} files (this is fine, a handful missing won't matter)")

