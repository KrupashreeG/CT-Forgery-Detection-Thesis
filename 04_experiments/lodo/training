import os, random, time, json
import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import Dataset, DataLoader
import torchvision.transforms as transforms
from PIL import Image
from sklearn.metrics import (roc_auc_score, confusion_matrix, f1_score,
                              precision_score, recall_score, accuracy_score)
import timm

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Device: {device}")
if torch.cuda.is_available():
    print(f"GPU: {torch.cuda.get_device_name(0)}")

torch.manual_seed(42)
np.random.seed(42)
random.seed(42)

BASE = "/content/gdrive/MyDrive/thesis_project"

# NEW folder -- keeps this run completely separate from the buggy one
RESULTS_LODO = f"{BASE}/results/lodo_v3_corrected"
MODEL_LODO = f"{BASE}/models/lodo_v3_corrected"
os.makedirs(RESULTS_LODO, exist_ok=True)
os.makedirs(MODEL_LODO, exist_ok=True)

LOCAL_CACHE = "/content/lodo_cache"
LOCAL_AUTH = f"{LOCAL_CACHE}/authentic"

attack_names = ["gaussian", "elliptical", "copymove", "frequency", "texture",
                "poisson", "contrast", "smoothing", "sharpening", "rotation", "cyclegan"]
LOCAL_ATTACKS = {name: f"{LOCAL_CACHE}/{name}" for name in attack_names}

BUDGET_PER_ATTACK = 3000  # confirmed, will be verified below -- no silent cuts


class CTDataset(Dataset):
    def __init__(self, samples, augment=False):
        self.samples = samples
        base_t = [
            transforms.Resize((224, 224)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
        ]
        if augment:
            base_t.insert(0, transforms.RandomHorizontalFlip())
        self.transform = transforms.Compose(base_t)

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        path, label = self.samples[idx]
        try:
            img = Image.open(path).convert('RGB')
            return (self.transform(img), torch.tensor(label, dtype=torch.float32))
        except Exception:
            return self.__getitem__(random.randint(0, len(self)-1))


def build_model():
    backbone = timm.create_model('efficientnet_b3', pretrained=True, num_classes=0)
    feat_dim = backbone.num_features
    head = nn.Sequential(
        nn.Dropout(0.3), nn.Linear(feat_dim, 256), nn.ReLU(),
        nn.Dropout(0.15), nn.Linear(256, 1)
    )
    class Wrapped(nn.Module):
        def __init__(self, backbone, head):
            super().__init__()
            self.backbone = backbone
            self.head = head
        def forward(self, x):
            return self.head(self.backbone(x)).squeeze(1)
    return Wrapped(backbone, head).to(device)


def evaluate_full(model, loader):
    model.eval()
    preds, labels = [], []
    with torch.no_grad():
        for imgs, lbls in loader:
            imgs = imgs.to(device)
            out = torch.sigmoid(model(imgs)).cpu().numpy()
            preds.extend(out); labels.extend(lbls.numpy())
    preds, labels = np.array(preds), np.array(labels)

    auc = roc_auc_score(labels, preds)
    bin_preds = (preds >= 0.5).astype(int)
    tn, fp, fn, tp = confusion_matrix(labels, bin_preds, labels=[0,1]).ravel()

    acc = accuracy_score(labels, bin_preds)
    precision = precision_score(labels, bin_preds, zero_division=0)
    recall = recall_score(labels, bin_preds, zero_division=0)
    f1 = f1_score(labels, bin_preds, zero_division=0)
    fnr = fn/(fn+tp) if (fn+tp) > 0 else 0.0
    fpr = fp/(fp+tn) if (fp+tn) > 0 else 0.0
    specificity = tn/(tn+fp) if (tn+fp) > 0 else 0.0

    return {
        "auc": float(auc), "accuracy": float(acc),
        "precision": float(precision), "recall": float(recall), "f1": float(f1),
        "fnr": float(fnr), "fpr": float(fpr), "specificity": float(specificity),
        "tn": int(tn), "fp": int(fp), "fn": int(fn), "tp": int(tp),
        "preds": preds.tolist(), "labels": labels.tolist(),
    }


def bootstrap_ci(preds, labels, n_boot=1000, seed=42):
    rng = np.random.RandomState(seed)
    preds, labels = np.array(preds), np.array(labels)
    aucs = []
    n = len(preds)
    for _ in range(n_boot):
        idx = rng.randint(0, n, n)
        if len(np.unique(labels[idx])) < 2: continue
        aucs.append(roc_auc_score(labels[idx], preds[idx]))
    return float(np.percentile(aucs, 2.5)), float(np.percentile(aucs, 97.5))


def sample_authentic_with_replacement(pool, n_needed, rng):
    """Draw n_needed authentic patches with replacement from the fixed
    10k-patch manifest pool. This preserves the documented authentic
    class definition (Section 3.2.2) while allowing the tampered pool
    to reach its intended per-attack budget without being silently
    capped down to the authentic pool's raw size."""
    indices = rng.integers(0, len(pool), size=n_needed)
    return [pool[i] for i in indices]


def run_fold(held_out):
    fold_path = f"{RESULTS_LODO}/fold_{held_out}.json"
    if os.path.exists(fold_path):
        with open(fold_path) as f:
            result = json.load(f)
        print(f"[{held_out}] already done, skipping (gap={result['gap']:.4f})")
        return result

    print(f"\n{'='*60}\nFOLD: held-out={held_out}\n{'='*60}")
    random.seed(42); np.random.seed(42); torch.manual_seed(42)
    rng = np.random.default_rng(42)

    train_attacks = [a for a in attack_names if a != held_out]

    auth_pool = sorted([os.path.join(LOCAL_AUTH, f) for f in os.listdir(LOCAL_AUTH) if f.endswith('.png')])
    print(f"Authentic manifest pool size: {len(auth_pool)}")

    tamper_files = []
    for name in train_attacks:
        folder = LOCAL_ATTACKS[name]
        files = sorted([os.path.join(folder, f) for f in os.listdir(folder) if f.endswith('.png')])
        random.shuffle(files)
        chosen = files[:BUDGET_PER_ATTACK]
        tamper_files += chosen
        print(f"  {name:12s}: {len(chosen)} patches used (budget={BUDGET_PER_ATTACK})")

    total_tampered = len(tamper_files)
    print(f"Total tampered pool: {total_tampered}")

    # KEY FIX: sample authentic WITH replacement to match tampered pool size,
    # instead of capping tampered down to the smaller authentic pool
    auth_files = sample_authentic_with_replacement(auth_pool, total_tampered, rng)
    print(f"Authentic samples drawn (with replacement): {len(auth_files)}")

    assert len(auth_files) == len(tamper_files), "Pool size mismatch -- budget was cut, investigate"

    files = auth_files + tamper_files
    labels = [0]*len(auth_files) + [1]*len(tamper_files)
    combined = list(zip(files, labels)); random.shuffle(combined)
    files, labels = zip(*combined)

    n_train = int(0.8*len(files)); n_val = int(0.1*len(files))
    train_samples = list(zip(files[:n_train], labels[:n_train]))
    val_samples   = list(zip(files[n_train:n_train+n_val], labels[n_train:n_train+n_val]))
    test_samples  = list(zip(files[n_train+n_val:], labels[n_train+n_val:]))

    train_loader = DataLoader(CTDataset(train_samples, augment=True), batch_size=32, shuffle=True, num_workers=2)
    val_loader   = DataLoader(CTDataset(val_samples), batch_size=32, shuffle=False, num_workers=2)
    test_loader  = DataLoader(CTDataset(test_samples), batch_size=32, shuffle=False, num_workers=2)

    # Zero-day set: held-out attack, full available patches, matched
    # 1:1 with fresh authentic draws (also with replacement, same manifest)
    zd_folder = LOCAL_ATTACKS[held_out]
    zd_tamper = sorted([os.path.join(zd_folder, f) for f in os.listdir(zd_folder) if f.endswith('.png')])
    zd_auth = sample_authentic_with_replacement(auth_pool, len(zd_tamper), rng)
    zd_samples = [(p,1) for p in zd_tamper] + [(p,0) for p in zd_auth]
    zd_loader = DataLoader(CTDataset(zd_samples), batch_size=32, shuffle=False, num_workers=2)

    print(f"\nTrain: {len(train_samples)} | Val: {len(val_samples)} | "
          f"Seen-test: {len(test_samples)} | Zero-day: {len(zd_samples)}")
    print(f"Per-attack effective budget confirmed: {BUDGET_PER_ATTACK}\n")

    model = build_model()
    criterion = nn.BCEWithLogitsLoss()
    optimizer = optim.Adam(model.parameters(), lr=1e-4)
    scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=40)

    best_val_auc, best_state, patience_ctr = 0.0, None, 0
    for epoch in range(40):
        t0 = time.time()
        model.train()
        for imgs, lbls in train_loader:
            imgs, lbls = imgs.to(device), lbls.to(device)
            optimizer.zero_grad()
            loss = criterion(model(imgs), lbls)
            loss.backward(); optimizer.step()
        scheduler.step()

        val_out = evaluate_full(model, val_loader)
        val_auc = val_out["auc"]
        print(f"  epoch {epoch+1:2d}  val_auc={val_auc:.4f}  ({time.time()-t0:.0f}s)")

        if val_auc > best_val_auc:
            best_val_auc = val_auc
            best_state = {k: v.cpu().clone() for k, v in model.state_dict().items()}
            patience_ctr = 0
        else:
            patience_ctr += 1
            if patience_ctr >= 5:
                print(f"  Early stop at epoch {epoch+1}"); break

    model.load_state_dict(best_state)
    torch.save(best_state, f"{MODEL_LODO}/fold_{held_out}_model.pt")

    seen_result = evaluate_full(model, test_loader)
    zd_result = evaluate_full(model, zd_loader)
    seen_ci = bootstrap_ci(seen_result["preds"], seen_result["labels"])
    zd_ci = bootstrap_ci(zd_result["preds"], zd_result["labels"])
    gap = seen_result["auc"] - zd_result["auc"]

    result = {
        "held_out": held_out, "budget_per_attack": BUDGET_PER_ATTACK,
        "best_val_auc": best_val_auc,
        "seen_auc": seen_result["auc"], "seen_ci": list(seen_ci),
        "seen_accuracy": seen_result["accuracy"], "seen_precision": seen_result["precision"],
        "seen_recall": seen_result["recall"], "seen_f1": seen_result["f1"],
        "seen_fnr": seen_result["fnr"], "seen_fpr": seen_result["fpr"],
        "seen_specificity": seen_result["specificity"],
        "seen_confusion": {"tn": seen_result["tn"], "fp": seen_result["fp"],
                            "fn": seen_result["fn"], "tp": seen_result["tp"]},
        "zeroday_auc": zd_result["auc"], "zeroday_ci": list(zd_ci),
        "zeroday_accuracy": zd_result["accuracy"], "zeroday_precision": zd_result["precision"],
        "zeroday_recall": zd_result["recall"], "zeroday_f1": zd_result["f1"],
        "zeroday_fnr": zd_result["fnr"], "zeroday_fpr": zd_result["fpr"],
        "zeroday_specificity": zd_result["specificity"],
        "zeroday_confusion": {"tn": zd_result["tn"], "fp": zd_result["fp"],
                               "fn": zd_result["fn"], "tp": zd_result["tp"]},
        "gap": gap,
    }

    with open(fold_path, "w") as f:
        json.dump(result, f, indent=2)

    print(f"\n>> seen AUC={seen_result['auc']:.4f} | zero-day AUC={zd_result['auc']:.4f} | "
          f"F1={zd_result['f1']:.4f} | gap={gap:.4f}")
    return result


all_results = []
t0 = time.time()
for held_out in attack_names:
    result = run_fold(held_out)
    all_results.append(result)
    print(f"[{len(all_results)}/{len(attack_names)} folds done, "
          f"{(time.time()-t0)/60:.1f} min elapsed]\n")

gaps = [r["gap"] for r in all_results]
summary = {
    "budget_per_attack": BUDGET_PER_ATTACK,
    "sampling_note": "Authentic patches sampled with replacement from the 10,000-patch manifest to match the intended per-attack tampered budget without capping.",
    "folds": all_results,
    "mean_gap": float(np.mean(gaps)),
    "std_gap": float(np.std(gaps)),
    "min_gap": float(np.min(gaps)),
    "max_gap": float(np.max(gaps)),
}
with open(f"{RESULTS_LODO}/summary_full.json", "w") as f:
    json.dump(summary, f, indent=2)

print(f"\n{'='*60}\nALL {len(attack_names)} FOLDS COMPLETE\n{'='*60}")
for r in all_results:
    print(f"  {r['held_out']:12s} gap={r['gap']:.4f} F1={r['zeroday_f1']:.4f}")
print(f"\nMean gap: {summary['mean_gap']:.4f} (std {summary['std_gap']:.4f})")
print(f"Total time: {(time.time()-t0)/60:.1f} minutes")





